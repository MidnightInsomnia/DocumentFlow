POSTGRES_DB=documentflow
POSTGRES_USER=documentflow
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# .NET runtime examples (root .env is not imported automatically by dotnet run)
# ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=documentflow;Username=documentflow;Password=change_me
# Required for API JWT; supply a unique random signing key (at least 32 UTF-8 bytes) locally.
# Auth__Jwt__Issuer=DocumentFlow
# Auth__Jwt__Audience=DocumentFlow.Web
# Auth__Jwt__SigningKey=
# Auth__Jwt__LifetimeMinutes=60
# First startup with no Admin: set username, display name and a strong password.
# Auth__BootstrapAdmin__UserName=
# Auth__BootstrapAdmin__Password=
# Auth__BootstrapAdmin__DisplayName=
# Auth__BootstrapAdmin__Email=
# DocumentStorage__RootPath=C:\absolute\path\to\documentflow\storage\documents
# Routing__Invoice=Accounting
# Routing__Act=Accounting
# Routing__Contract=Legal
# Tesseract__ExecutablePath=tesseract
AiReview__Enabled=false
